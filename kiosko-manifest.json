  "sources": [
    {
      "type": "gpu/devices",
      "name": {
        "en": "GPUs",
        "es": "GPU"
      },
      "description": {
        "en": "Temperature, load, VRAM (and who holds it), power, fan and clocks per GPU, from this machine, another over ssh, or a Prometheus exporter.",
        "es": "Temperatura, carga, VRAM (y quién la ocupa), potencia, ventilador y relojes por GPU, de esta máquina, de otra por ssh o de un exporter de Prometheus."
      },
      "polled": true,
      "intervalMs": 5000,
      "options": {
        "default": {
          "backend": "auto",
          "ssh": "",
          "url": "",
          "token": "",
          "label": "",
          "processes": true,
          "historyMs": 1800000
        },
        "x-ui": {},
        "type": "object",
        "properties": {
          "backend": {
            "title": "Back end",
            "description": "auto tries the metrics URL (if set), nvidia-smi, rocm-smi / amd-smi and sysfs, in that order.",
            "default": "auto",
            "x-ui": {
              "label": {
                "en": "Back end",
                "es": "Origen"
              },
              "help": {
                "en": "auto tries the metrics URL (if set), nvidia-smi, rocm-smi / amd-smi and sysfs, in that order.",
                "es": "auto prueba la URL de métricas (si hay), nvidia-smi, rocm-smi / amd-smi y sysfs, por ese orden."
              },
              "labels": {
                "auto": {
                  "en": "Automatic",
                  "es": "Automático"
                },
                "nvidia": "NVIDIA (nvidia-smi)",
                "amd": "AMD (rocm-smi, amd-smi, sysfs)",
                "intel": {
                  "en": "Intel (sysfs, best effort)",
                  "es": "Intel (sysfs, lo que se pueda)"
                },
                "prometheus": "Prometheus (DCGM / nvidia_gpu_exporter)"
              }
            },
            "type": "string",
            "enum": [
              "auto",
              "nvidia",
              "amd",
              "intel",
              "prometheus"
            ]
          },
          "ssh": {
            "title": "Read over ssh",
            "description": "Runs nvidia-smi / rocm-smi on that host with ssh -o BatchMode=yes: needs key login. Empty = this machine.",
            "default": "",
            "x-ui": {
              "label": {
                "en": "Read over ssh",
                "es": "Leer por ssh"
              },
              "help": {
                "en": "Runs nvidia-smi / rocm-smi on that host with ssh -o BatchMode=yes: needs key login. Empty = this machine.",
                "es": "Ejecuta nvidia-smi / rocm-smi en ese host con ssh -o BatchMode=yes: necesita acceso por clave. Vacío = esta máquina."
              },
              "placeholder": "user@gpubox"
            },
            "x-risk": "exec",
            "type": "string"
          },
          "url": {
            "title": "Metrics URL",
            "description": "DCGM exporter (port 9400) or nvidia_gpu_exporter (port 9835). Secret: leave it empty (or a placeholder such as \"<token>\"). Kiosko keeps the value it already has, or asks for it in the editor.",
            "default": "",
            "x-ui": {
              "label": {
                "en": "Metrics URL",
                "es": "URL de métricas"
              },
              "help": {
                "en": "DCGM exporter (port 9400) or nvidia_gpu_exporter (port 9835).",
                "es": "DCGM exporter (puerto 9400) o nvidia_gpu_exporter (puerto 9835)."
              },
              "secret": true,
              "placeholder": "http://gpubox:9400/metrics",
              "format": "url"
            },
            "x-secret": true,
            "x-risk": "network",
            "type": "string"
          },
          "token": {
            "title": "Metrics bearer token",
            "description": "Only if the metrics URL is behind auth. Secret: leave it empty (or a placeholder such as \"<token>\"). Kiosko keeps the value it already has, or asks for it in the editor.",
            "default": "",
            "x-ui": {
              "label": {
                "en": "Metrics bearer token",
                "es": "Token bearer de las métricas"
              },
              "help": {
                "en": "Only if the metrics URL is behind auth.",
                "es": "Solo si la URL de métricas pide autenticación."
              },
              "advanced": true,
              "secret": true
            },
            "x-secret": true,
            "type": "string"
          },
          "label": {
            "title": "Host label",
            "description": "Shown above the GPUs. Defaults to the ssh host.",
            "default": "",
            "x-ui": {
              "label": {
                "en": "Host label",
                "es": "Nombre del host"
              },
              "help": {
                "en": "Shown above the GPUs. Defaults to the ssh host.",
                "es": "Se muestra encima de las GPU. Por defecto, el host de ssh."
              },
              "placeholder": "gpubox"
            },
            "type": "string"
          },
          "processes": {
            "title": "Per-process VRAM",
            "description": "One more nvidia-smi call per reading.",
            "default": true,
            "x-ui": {
              "label": {
                "en": "Per-process VRAM",
                "es": "VRAM por proceso"
              },
              "help": {
                "en": "One more nvidia-smi call per reading.",
                "es": "Una llamada más a nvidia-smi por lectura."
              }
            },
            "type": "boolean"
          },
          "historyMs": {
            "title": "History kept",
            "description": "How far back GPU history can look.",
            "default": 1800000,
            "x-ui": {
              "label": {
                "en": "History kept",
                "es": "Historial guardado"
              },
              "help": {
                "en": "How far back GPU history can look.",
                "es": "Hasta dónde puede mirar atrás el historial de GPU."
              },
              "unit": "ms"
            },
            "type": "integer",
            "minimum": 60000,
            "maximum": 14400000
          }
        }
      }
    }
  ],
  "interludes": [],
  "templates": []
}
