            "default": [],
            "x-ui": {
              "label": {
                "en": "GPUs",
                "es": "GPU"
              },
              "help": {
                "en": "Empty: all. Indexes or model names, comma-separated: * matches anything, a leading ! leaves out (0, 1, *4090*, !*A6000*).",
                "es": "Vacío: todas. Índices o modelos separados por comas: * vale por cualquier cosa y un ! delante excluye (0, 1, *4090*, !*A6000*)."
              },
