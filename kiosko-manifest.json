{
  "manifest": 1,
  "id": "gpu",
  "package": "kiosko-plugin-gpu",
  "name": {
    "en": "GPU",
    "es": "GPU"
  },
  "version": "0.2.0",
  "description": {
    "en": "The GPUs of your AI box: temperature, load, VRAM by process and history. Local, over ssh or from a Prometheus exporter.",
    "es": "Las GPU de tu máquina de IA: temperatura, carga, VRAM por proceso e historial. En local, por ssh o desde un exporter de Prometheus."
  },
  "author": "Kiosko",
  "license": "MIT",
  "homepage": "https://github.com/kiosko-lcd/kiosko-plugin-gpu#readme",
  "repository": "https://github.com/kiosko-lcd/kiosko-plugin-gpu.git",
  "icon": "cpu",
  "sdk": "^0.2.0",
  "platforms": [
    "linux",
    "darwin",
    "win32"
  ],
  "languages": [
    "en",
    "es"
  ],
  "categories": [
    "system"
  ],
  "tags": [
    "gpu",
    "nvidia",
    "amd",
    "vram",
    "temperature",
    "ai",
    "models",
    "history",
    "chart"
  ],
  "permissions": {
    "exec": [
      "nvidia-smi",
      "rocm-smi",
      "amd-smi",
      "ssh"
    ],
    "files": [
      "/sys/class/drm"
    ],
    "network": [
      "user"
    ]
  },
  "riskyOptions": [
    {
      "path": "gpu/devices: ssh",
      "risk": [
        "exec"
      ],
      "secret": false
    },
    {
      "path": "gpu/devices: url",
      "risk": [
        "network"
      ],
      "secret": true
    },
    {
      "path": "gpu/devices: token",
      "risk": [],
      "secret": true
    }
  ],
  "requires": [],
  "optional": [],
  "widgets": [
    {
      "type": "gpu/cards",
      "name": {
        "en": "GPU cards",
        "es": "Tarjetas de GPU"
      },
      "description": {
        "en": "One column per GPU: temperature, load, VRAM and power bars, fan and throttling. Dim until a threshold is crossed.",
        "es": "Una columna por GPU: temperatura, carga, barras de VRAM y potencia, ventilador y limitación. Apagada hasta cruzar un umbral."
      },
      "icon": "cpu",
      "category": "system",
      "tags": [
        "gpu",
        "nvidia",
        "amd",
        "vram",
        "temperature",
        "ai"
      ],
      "size": {
        "min": {
          "w": 150,
          "h": 120
        },
        "preferred": {
          "w": 640,
          "h": 462
        }
      },
      "chrome": "card",
      "sources": [
        "gpu/devices"
      ],
      "options": {
        "default": {
          "tempWarn": 80,
          "tempAlert": 90,
          "vramWarn": 90,
          "vramAlert": 97,
          "gpus": []
        },
        "x-ui": {},
        "type": "object",
        "properties": {
          "tempWarn": {
            "title": "Amber temperature",
            "default": 80,
            "x-ui": {
              "label": {
                "en": "Amber temperature",
                "es": "Temperatura ámbar"
              },
              "unit": "°C"
            },
            "type": "integer",
            "minimum": 30,
            "maximum": 120
          },
          "tempAlert": {
            "title": "Red temperature",
            "description": "Of the core (the hotspot or memory sensor when there is no core one). The widget keeps the tile while a GPU is past it.",
            "default": 90,
            "x-ui": {
              "label": {
                "en": "Red temperature",
                "es": "Temperatura roja"
              },
              "help": {
                "en": "Of the core (the hotspot or memory sensor when there is no core one). The widget keeps the tile while a GPU is past it.",
                "es": "Del núcleo (o del sensor de hotspot o de memoria si no hay del núcleo). El widget se queda la tesela mientras una GPU la pase."
              },
              "unit": "°C"
            },
            "type": "integer",
            "minimum": 30,
            "maximum": 120
          },
          "vramWarn": {
            "title": "Amber VRAM from",
            "default": 90,
            "x-ui": {
              "label": {
                "en": "Amber VRAM from",
                "es": "VRAM ámbar desde"
              },
              "unit": "%",
              "slider": true
            },
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          },
          "vramAlert": {
            "title": "Red VRAM from",
            "default": 97,
            "x-ui": {
              "label": {
                "en": "Red VRAM from",
                "es": "VRAM roja desde"
              },
              "unit": "%",
              "slider": true
            },
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          },
          "gpus": {
            "title": "GPUs",
            "description": "Empty: all. Indexes or model names, comma-separated: * matches anything, a leading ! leaves out (0, 1, *4090*, !*A6000*).",
            "default": [],
            "x-ui": {
              "label": {
                "en": "GPUs",
                "es": "GPU"
              },
              "help": {
                "en": "Empty: all. Indexes or model names, comma-separated: * matches anything, a leading ! leaves out (0, 1, *4090*, !*A6000*).",
                "es": "Vacío: todas. Índices o modelos separados por comas: * vale por cualquier cosa y un ! delante excluye (0, 1, *4090*, !*A6000*)."
              },
              "widget": "filter"
            },
            "type": "array",
            "items": {
              "default": "",
              "x-ui": {
                "placeholder": "name, group/*, !old-*"
              },
              "type": "string"
            },
            "x-filter": true
          }
        }
      },
      "screenshot": "docs/cards.png",
      "animated": false,
      "urgent": true
    },
    {
      "type": "gpu/vram",
      "name": {
        "en": "GPU memory",
        "es": "Memoria de GPU"
      },
      "description": {
        "en": "VRAM per GPU as a bar stacked by process (ollama, vllm, python…), with what is left free.",
        "es": "VRAM por GPU como una barra apilada por proceso (ollama, vllm, python…), con lo que queda libre."
